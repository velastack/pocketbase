{
	"name": "@velastack/pocketbase",
	"version": "0.2.1",
	"description": "PocketBase bindings for SvelteKit: a hooks.server.ts middleware and type-safe collection schemas.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/velastack/pocketbase.git"
	},
	"homepage": "https://github.com/velastack/pocketbase#readme",
	"bugs": {
		"url": "https://github.com/velastack/pocketbase/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"pretest": "npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"prepack": "npm run build && publint"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./api-key": {
			"types": "./dist/api-key.d.ts",
			"default": "./dist/api-key.js"
		},
		"./form": {
			"types": "./dist/form.d.ts",
			"default": "./dist/form.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"dependencies": {
		"@velastack/kit": "^0.1.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"@types/supertest": "^6.0.0",
		"pocketbase-sveltekit": "^0.28.0",
		"sveltekit-superforms": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@types/supertest": {
			"optional": true
		},
		"sveltekit-superforms": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.57.1",
		"@types/node": "^22.0.0",
		"@types/supertest": "^6.0.3",
		"pocketbase-sveltekit": "^0.28.0",
		"prettier": "^3.4.2",
		"publint": "^0.3.2",
		"sveltekit-superforms": "^2.30.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"pocketbase",
		"velastack"
	]
}
